# ===== LLM provider =====
# Groq (free-tier friendly, OpenAI-compatible API) — the only chat provider.
# Leave GROQ_API_KEY empty to run in honest offline mode (extractive, clearly labelled answers).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# auto | groq | local   (local = offline extractive fallback; embeddings are always local)
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=local

# ===== Vector store =====
# auto | pinecone | local
VECTOR_BACKEND=auto
PINECONE_API_KEY=
PINECONE_INDEX=droneops
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
LOCAL_VECTOR_STORE_PATH=data/vector_store.json
RAG_TOP_K=4
# Below this top-score the regulation agent refuses and issues safe guidance instead of guessing
RAG_CONFIDENCE_THRESHOLD=0.33

# ===== Storage (tickets + approvals + run audit) =====
# sqlite (default) or e.g. postgresql+psycopg2://droneops:droneops@localhost:5432/droneops
DATABASE_URL=sqlite:///data/droneops.db

# ===== LangSmith tracing (env-gated) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drone-ops-agent
# Set if using a regional/custom endpoint (e.g. EU or AWS-hosted LangSmith)
LANGSMITH_ENDPOINT=
# LANGSMITH_AGENT_ID / LANGSMITH_AGENT_ENVIRONMENT are for Agent Server deployments; ignored by this app.

# ===== Airspace / NOTAM proxy =====
AVIATIONWEATHER_BASE_URL=https://aviationweather.gov/api/data
# NOTAM provider: simulated (default, labelled) | http (real keyed endpoint)
NOTAM_PROVIDER=simulated
# Real NOTAM (set NOTAM_PROVIDER=http + both values). Generic keyed HTTP mapping:
NOTAM_API_URL=
NOTAM_API_KEY=
NOTAM_API_KEY_HEADER=Authorization
# If your provider takes the key as a query param instead of a header, set this (e.g. access_key)
NOTAM_API_KEY_PARAM=
NOTAM_CACHE_TTL_S=900
HTTP_TIMEOUT_S=8.0
# NOTE: FAA official NOTAM systems require registered access; many operators use a commercial provider.
# Default is SIMULATED and clearly labelled. Never treat simulated NOTAMs as operational data.

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
FLIGHT_LOGS_DIR=data/sample_logs

# ===== Frontend =====
DRONEOPS_API=http://127.0.0.1:8000
