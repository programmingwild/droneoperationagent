# ===== LLM provider =====
# Leave empty to run in honest offline mode (extractive, clearly labelled answers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# auto | openai | local   (local = sentence-transformers all-MiniLM-L6-v2, offline)
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# ===== Vector store =====
# auto | pinecone | local
VECTOR_BACKEND=auto
PINECONE_API_KEY=
PINECONE_INDEX=droneops
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
LOCAL_VECTOR_STORE_PATH=data/vector_store.json
RAG_TOP_K=4
# Below this top-score the regulation agent refuses and issues safe guidance instead of guessing
RAG_CONFIDENCE_THRESHOLD=0.33

# ===== Storage (tickets + approvals + run audit) =====
# sqlite (default) or e.g. postgresql+psycopg2://droneops:droneops@localhost:5432/droneops
DATABASE_URL=sqlite:///data/droneops.db

# ===== LangSmith tracing (env-gated) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drone-ops-agent

# ===== Airspace / NOTAM proxy =====
AVIATIONWEATHER_BASE_URL=https://aviationweather.gov/api/data
NOTAM_CACHE_TTL_S=900
HTTP_TIMEOUT_S=8.0
# NOTE: the NOTAM layer is SIMULATED until a keyed FAA/commercial NOTAM API is wired in.
# METAR/TAF fetches are real (aviationweather.gov, no key required).

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
FLIGHT_LOGS_DIR=data/sample_logs

# ===== Frontend =====
DRONEOPS_API=http://127.0.0.1:8000
